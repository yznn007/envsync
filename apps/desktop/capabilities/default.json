{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "仅允许主窗口调用 EnvSync 审核过的 application-service 命令",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-onboarding-select-root",
    "allow-onboarding-create-workspace",
    "allow-onboarding-open-workspace",
    "allow-workspace-status",
    "allow-workspace-plan",
    "allow-plan-diff",
    "allow-workspace-apply",
    "allow-conflict-list",
    "allow-conflict-show",
    "allow-conflict-resolve",
    "allow-operation-history",
    "allow-operation-detail",
    "allow-operation-rollback-review",
    "allow-operation-rollback",
    "allow-vault-metadata",
    "allow-device-list",
    "allow-device-revoke",
    "allow-bundle-review",
    "allow-operation-cancel"
  ]
}
